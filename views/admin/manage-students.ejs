<%- include('../partials/header') %>
<%- include('../partials/nav') %>
<main id="main-content">
    <div class="dashboard-grid">
        <aside class="dashboard-sidebar">
                        <ul class="sidebar-menu">
                <li><a href="/admin/owner">&#x1F3E0; Dashboard</a></li>
                <li><a href="/admin/owner/calendar">&#x1F4C5; Calendar</a></li>
                <li><a href="/admin/owner/availability">&#x1F552; Availability</a></li>
                <li><a href="/admin/owner/match"><li><a href="/admin/owner/tutors">#x1F4A1; Tutor Match</a></li>
                <li><a href="/admin/owner/tutors">&#x1F468;&#x200D;&#x1F3EB; Tutors</a></li>
                <li><a href="/admin/owner/students">&#x1F393; Students</a></li>
                <li><a href="/admin/owner/sheets">&#x1F4CB; Session Sheets</a></li>
                <li><a href="/parent/messages">&#x1F4AC; Messages</a></li>
                <li><a href="/admin/owner/audit-log">&#x1F4DC; Audit Log</a></li>
                <li><a href="/admin/owner/blog">&#x1F4DD; Blog</a></li>
                <li><a href="/admin/owner/referrals">&#x1F381; Referrals</a></li>
                <li><a href="/admin/owner/settings">&#x2699;&#xFE0F; Settings</a></li>
                <li><a href="/admin/owner/profile">&#x1F464; My Profile</a></li>
            </ul>
        </aside>
        <div class="dashboard-main">
            <h1 style="font-size:1.5rem;margin-bottom:24px;">Manage Students</h1>

            <!-- Assign tutor -->
            <% if (tutors && tutors.length > 0) { %>
            <div class="card" style="padding:24px;margin-bottom:24px;">
                <h3 style="font-size:1.1rem;margin-bottom:12px;">Assign Tutor to Student</h3>
                <form action="/admin/owner/assign-tutor" method="POST" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group" style="margin:0;flex:1;min-width:200px;">
                        <label>Select Tutor</label>
                        <select name="tutor_id" class="form-control" required>
                            <option value="">Choose tutor...</option>
                            <% tutors.forEach(function(t) { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }); %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;flex:1;min-width:200px;">
                        <label>Select Student</label>
                        <select name="student_id" class="form-control" required>
                            <option value="">Choose student...</option>
                            <% students.forEach(function(s) { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }); %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Assign</button>
                </form>
            </div>
            <% } %>

            <!-- Create recurring meeting -->
            <div class="card" style="padding:24px;margin-bottom:24px;">
                <h3 style="font-size:1.1rem;margin-bottom:12px;">Create Recurring Meeting</h3>
                <p style="color:var(--gray-500);font-size:0.85rem;margin-bottom:12px;">Generate confirmed weekly sessions for a student and tutor.</p>
                <form action="/admin/owner/recurring" method="POST" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group" style="margin:0;min-width:150px;">
                        <label>Tutor</label>
                        <select name="tutor_id" class="form-control" required>
                            <option value="">Tutor...</option>
                            <% tutors.forEach(function(t) { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }); %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;min-width:150px;">
                        <label>Student</label>
                        <select name="student_id" class="form-control" required>
                            <option value="">Student...</option>
                            <% students.forEach(function(s) { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }); %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;min-width:120px;">
                        <label>Day</label>
                        <select name="day_of_week" class="form-control" required>
                            <option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;min-width:100px;">
                        <label>Start</label>
                        <input type="time" name="start_time" class="form-control" required>
                    </div>
                    <div class="form-group" style="margin:0;min-width:100px;">
                        <label>End</label>
                        <input type="time" name="end_time" class="form-control" required>
                    </div>
                    <div class="form-group" style="margin:0;min-width:120px;">
                        <label>Subject</label>
                        <input type="text" name="subject" class="form-control" placeholder="Math" value="General">
                    </div>
                    <div class="form-group" style="margin:0;min-width:80px;">
                        <label>Weeks</label>
                        <input type="number" name="weeks" class="form-control" value="8" min="1" max="52">
                    </div>
                    <button type="submit" class="btn btn-primary">Create Schedule</button>
                </form>
            </div>

            <!-- Group Session -->
            <div class="card" style="padding:24px;margin-bottom:24px;">
                <h3 style="font-size:1.1rem;margin-bottom:12px;">Add Student to Existing Time Slot</h3>
                <p style="color:var(--gray-500);font-size:0.85rem;margin-bottom:12px;">Pick a tutor to see their recurring slots and add more students (up to 4 per slot).</p>
                <div style="display:flex;gap:12px;align-items:end;margin-bottom:16px;">
                    <div class="form-group" style="margin:0;min-width:180px;">
                        <label>Select Tutor</label>
                        <select id="slot-tutor-select" class="form-control" onchange="loadSlots()">
                            <option value="">Choose tutor...</option>
                            <% tutors.forEach(function(t) { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }); %>
                        </select>
                    </div>
                </div>
                <div id="slot-list" style="color:var(--gray-400);font-size:0.9rem;"></div>
            </div>

            <script>
            function loadSlots() {
                var tid = document.getElementById('slot-tutor-select').value;
                var el = document.getElementById('slot-list');
                if (!tid) { el.innerHTML = ''; return; }
                fetch('/api/tutor-slots/' + tid).then(function(r){return r.json()}).then(function(data) {
                    if (!data.success || !data.slots.length) { el.innerHTML = '<p>No recurring slots found for this tutor.</p>'; return; }
                    var html = '<div style="display:grid;gap:8px;">';
                    data.slots.forEach(function(s) {
                        var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                        var full = s.student_count >= 4;
                        html += '<div style="display:flex;align-items:center;gap:12px;padding:12px;background:var(--gray-50);border-radius:8px;">';
                        html += '<div style="flex:1;"><strong>' + days[s.day] + '</strong> ' + s.start_time + '-' + s.end_time + ' &middot; ' + s.subject;
                        html += ' <span style="font-size:0.8rem;color:' + (full ? 'var(--red-500)' : 'var(--green-600)') + ';font-weight:700;">' + s.student_count + '/4 students</span>';
                        html += '<br><span style="font-size:0.8rem;color:var(--gray-400);">' + s.student_names + '</span></div>';
                        if (!full) {
                            html += '<form action="/admin/owner/add-to-slot" method="POST" style="display:flex;gap:4px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">';
                            html += '<input type="hidden" name="tutor_id" value="' + tid + '"><input type="hidden" name="day" value="' + s.day + '"><input type="hidden" name="start_time" value="' + s.start_time + '"><input type="hidden" name="end_time" value="' + s.end_time + '"><input type="hidden" name="subject" value="' + s.subject + '">';
                            html += '<select name="student_id" class="form-control" style="width:auto;padding:4px;font-size:0.8rem;" required>';
                            html += '<option value="">Add student...</option>';
                            <% students.forEach(function(st) { %>html += '<option value="<%= st.id %>"><%= st.first_name %> <%= st.last_name %></option>';<% }); %>
                            html += '</select><button type="submit" class="btn btn-sm btn-primary" style="font-size:0.75rem;">Add</button></form>';
                        }
                        html += '</div>';
                    });
                    html += '</div>';
                    el.innerHTML = html;
                });
            }
            </script>

            <!-- Create New Group Session -->
            <div class="card" style="padding:24px;margin-bottom:24px;">
                <h3 style="font-size:1.1rem;margin-bottom:12px;">Create Group Session (up to 6 students)</h3>
                <p style="color:var(--gray-500);font-size:0.85rem;margin-bottom:12px;">All selected students join the same video room with one tutor.</p>
                <form action="/admin/owner/group-session" method="POST" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group" style="margin:0;min-width:150px;">
                        <label>Tutor</label>
                        <select name="tutor_id" class="form-control" required>
                            <option value="">Tutor...</option>
                            <% tutors.forEach(function(t) { %><option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option><% }); %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;min-width:200px;">
                        <label>Students (hold Ctrl to multi-select)</label>
                        <select name="student_ids" class="form-control" multiple required style="min-height:100px;">
                            <% students.forEach(function(s) { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }); %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;min-width:130px;">
                        <label>Date</label>
                        <input type="date" name="booking_date" class="form-control" required>
                    </div>
                    <div class="form-group" style="margin:0;min-width:100px;">
                        <label>Start</label>
                        <input type="time" name="start_time" class="form-control" required>
                    </div>
                    <div class="form-group" style="margin:0;min-width:100px;">
                        <label>End</label>
                        <input type="time" name="end_time" class="form-control" required>
                    </div>
                    <div class="form-group" style="margin:0;min-width:100px;">
                        <label>Subject</label>
                        <input type="text" name="subject" class="form-control" value="Group Session">
                    </div>
                    <button type="submit" class="btn btn-primary">Create Group</button>
                </form>
            </div>

            <!-- Student table -->
            <% if (students && students.length > 0) { %>
            <% students.forEach(function(s) {
                var sub = subscriptions[s.id];
                var sessionsUsed = sessionCounts[s.id] || 0;
                var sessionsAllowed = sub ? sub.sessions_per_month : 0;
                var isOverLimit = sessionsAllowed > 0 && sessionsUsed > sessionsAllowed;
                var extrasOwed = isOverLimit ? sessionsUsed - sessionsAllowed : 0;
                var perSession = (sub && sub.rate_total && sub.sessions_per_month) ? (parseFloat(sub.rate_total) / sub.sessions_per_month) : 0;
                var extraRate = (sub && sub.extra_session_rate) ? parseFloat(sub.extra_session_rate) : (perSession > 0 ? perSession + 5 : 0);
                var extrasTotal = extrasOwed * extraRate;
                var credits = sub ? (parseInt(sub.extra_session_credits) || 0) : 0;
            %>
            <div class="card" style="margin-bottom:16px;padding:20px;<%= isOverLimit ? 'border-left:4px solid var(--red-500);' : '' %>">
                <div style="display:flex;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:12px;">
                    <div>
                        <h4><%= s.first_name %> <%= s.last_name %></h4>
                        <p style="color:var(--gray-500);font-size:0.85rem;"><%= s.email %> &middot; <%= s.role %> &middot; Grade: <%= s.grade_level || 'N/A' %></p>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <span class="badge-status <%= s.email_verified ? 'badge-confirmed' : 'badge-pending' %>"><%= s.email_verified ? 'Approved' : 'Pending' %></span>
                        <span class="badge-status <%= s.payment_status === 'paid' ? 'badge-confirmed' : 'badge-cancelled' %>"><%= s.payment_status || 'unpaid' %></span>
                    </div>
                </div>

                <!-- Session count + plan -->
                <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap;">
                    <div style="padding:8px 16px;background:var(--gray-50);border-radius:8px;font-size:0.85rem;">
                        <strong>Sessions this month:</strong>
                        <span style="<%= isOverLimit ? 'color:var(--red-600);font-weight:700;' : '' %>"><%= sessionsUsed %></span>
                        / <%= sessionsAllowed || '0 (no plan)' %>
                        <% if (isOverLimit) { %><span style="color:var(--red-500);font-weight:700;"> OVER (+<%= extrasOwed %>)</span><% } %>
                    </div>
                    <% if (sub) { %>
                    <div style="padding:8px 16px;background:var(--blue-50);border-radius:8px;font-size:0.85rem;">
                        <strong>Plan:</strong> <%= sub.plan_name %> ($<%= sub.rate_total || '0' %>/mo)
                        &middot; Extra: $<%= extraRate.toFixed(2) %>/session
                    </div>
                    <% if (extrasOwed > 0) { %>
                    <div style="padding:8px 16px;background:#FEE2E2;border-radius:8px;font-size:0.85rem;color:var(--red-600);font-weight:700;">
                        Extras owed: <%= extrasOwed %> x $<%= extraRate.toFixed(2) %> = $<%= extrasTotal.toFixed(2) %>
                    </div>
                    <% } %>
                    <% if (credits > 0) { %>
                    <div style="padding:8px 16px;background:#D1FAE5;border-radius:8px;font-size:0.85rem;color:var(--green-600);font-weight:700;">
                        Extra credits: <%= credits %>
                    </div>
                    <% } %>
                    <% } %>
                </div>

                <!-- Actions -->
                <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;align-items:center;">
                    <% if (!s.email_verified) { %>
                    <form action="/admin/owner/users/<%= s.id %>/verify" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm" style="background:var(--green-500);color:white;font-size:0.75rem;">Approve</button></form>
                    <% } %>

                    <form action="/admin/owner/users/<%= s.id %>/payment" method="POST" style="display:flex;gap:4px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <select name="payment_status" style="padding:4px 8px;font-size:0.75rem;border-radius:6px;border:1px solid var(--gray-200);">
                            <option value="paid" <%= s.payment_status === 'paid' ? 'selected' : '' %>>Paid</option>
                            <option value="unpaid" <%= s.payment_status !== 'paid' ? 'selected' : '' %>>Unpaid</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline" style="font-size:0.7rem;">Set</button>
                    </form>

                    <a href="/admin/owner/notes/<%= s.id %>" class="btn btn-outline btn-sm" style="font-size:0.75rem;">Notes</a>

                    <details style="display:inline;"><summary class="btn btn-sm" style="background:var(--red-500);color:white;font-size:0.75rem;cursor:pointer;list-style:none;">Delete</summary><form action="/admin/owner/users/<%= s.id %>/delete" method="POST" style="margin-top:8px;display:flex;gap:4px;align-items:center;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="password" name="admin_password" placeholder="Admin password" class="form-control" style="width:140px;padding:4px 8px;font-size:0.8rem;" required><button type="submit" class="btn btn-sm btn-danger" style="font-size:0.7rem;">Confirm Delete</button></form></details>
                </div>

                <!-- Set Plan (collapsed) -->
                <details style="margin-top:12px;">
                    <summary style="cursor:pointer;font-size:0.85rem;color:var(--blue-600);font-weight:600;">Set/Edit Plan</summary>
                    <form action="/admin/owner/users/<%= s.id %>/plan" method="POST" style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin-top:8px;" class="plan-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group" style="margin:0;">
                            <label style="font-size:0.8rem;">Plan Name</label>
                            <input type="text" name="plan_name" class="form-control" style="padding:6px;font-size:0.85rem;width:120px;" value="<%= sub ? sub.plan_name : 'Starter' %>">
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label style="font-size:0.8rem;">Sessions/Month</label>
                            <input type="number" name="sessions_per_month" class="form-control plan-sessions" style="padding:6px;font-size:0.85rem;width:80px;" value="<%= sub ? sub.sessions_per_month : 4 %>" min="1">
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label style="font-size:0.8rem;">Per Session Rate ($)</label>
                            <input type="number" name="session_rate" class="form-control plan-session-rate" style="padding:6px;font-size:0.85rem;width:100px;" value="<%= (sub && sub.rate_total && sub.sessions_per_month) ? (parseFloat(sub.rate_total) / sub.sessions_per_month).toFixed(2) : '' %>" step="0.01" min="0">
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label style="font-size:0.8rem;">Total/Month ($)</label>
                            <input type="number" name="rate_total" class="form-control plan-total" style="padding:6px;font-size:0.85rem;width:100px;background:var(--gray-50);" value="<%= sub ? sub.rate_total : '' %>" step="0.01" min="0" readonly>
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label style="font-size:0.8rem;">Extra Session ($)</label>
                            <input type="number" name="extra_session_rate" class="form-control" style="padding:6px;font-size:0.85rem;width:100px;" value="<%= sub ? (sub.extra_session_rate || '') : '' %>" step="0.01" min="0" placeholder="Suggested: auto">
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm" style="font-size:0.8rem;">Save Plan</button>
                    </form>
                </details>
            </div>
            <% }); %>
            <% } else { %>
            <div class="card" style="padding:32px;text-align:center;"><p style="color:var(--gray-400);">No students yet.</p></div>
            <% } %>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>

<script>
// Auto-calculate total from session rate * sessions
document.querySelectorAll('.plan-form').forEach(function(form) {
    var sessions = form.querySelector('.plan-sessions');
    var rate = form.querySelector('.plan-session-rate');
    var total = form.querySelector('.plan-total');
    function calc() {
        var s = parseFloat(sessions.value) || 0;
        var r = parseFloat(rate.value) || 0;
        total.value = (s * r).toFixed(2);
    }
    sessions.addEventListener('input', calc);
    rate.addEventListener('input', calc);
});
</script>
