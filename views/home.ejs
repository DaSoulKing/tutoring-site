<%- include('partials/header') %>
<%- include('partials/nav') %>
<main id="main-content">
    <section class="hero" style="padding:120px 0 100px;">
        <div class="container">
            <div class="hero-inner">
                <div class="hero-text">
                    <h1 style="font-size:3.75rem;">A <span class="text-blue">Klever</span> Tutor<br>Changes <span class="text-yellow">Everything</span></h1>
                    <p style="font-size:1.15rem;line-height:1.8;">At Klever, we match students with expert tutors who get them. Their learning style, their pace, their goals. Whether they're struggling to keep up or ready to get ahead, our personalized sessions help them build real understanding and genuine confidence in any subject. From math and science to reading and test prep, we've got them covered.</p>
                    <div class="hero-buttons">
                        <a href="/consultation" class="btn btn-primary btn-lg">Book a Free Consultation</a>
                        <a href="/tutors" class="btn btn-outline btn-lg">Meet Our Tutors</a>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="hero-illustration" role="img" aria-label="Klever Learning">
                        <span class="emoji-big" aria-hidden="true">&#x1F4A1;</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="stats-bar" aria-label="Our impact in numbers">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item"><h3>20+</h3><p>Subjects Covered</p></div>
                <div class="stat-item"><h3>K-12</h3><p>Grades Covered</p></div>
                <div class="stat-item"><h3>$0</h3><p>First Session</p></div>
                <div class="stat-item"><h3>200+</h3><p>Students Helped</p></div>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="services-heading">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">What We Offer</span>
                <h2 id="services-heading">Learning Made Fun and Effective</h2>
                <p>From one-on-one sessions to group learning, we have the right solution for every student.</p>
            </div>
            <div class="services-grid">
                <div class="card service-card"><div class="card-icon blue" aria-hidden="true"><img src="/uploads/icons/icon-tutoring.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F4D6;';"></div><h3>One-on-One Tutoring</h3><p>Personalized attention tailored to your child's unique learning style and pace.</p></div>
                <div class="card service-card"><div class="card-icon yellow" aria-hidden="true"><img src="/uploads/icons/icon-groups.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F393;';"></div><h3>Group Sessions</h3><p>Learn together with peers in small, interactive group sessions with collaborative learning.</p></div>
                <div class="card service-card"><div class="card-icon blue" aria-hidden="true"><img src="/uploads/icons/icon-online.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F4BB;';"></div><h3>Online Learning</h3><p>Access expert tutoring from anywhere. No extra software or signups needed.</p></div>
                <div class="card service-card"><div class="card-icon orange" aria-hidden="true"><img src="/uploads/icons/icon-progress.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F4C5;';"></div><h3>Progress Tracking</h3><p>Detailed report cards, session notes, and regular check-ins every month.</p></div>
                <div class="card service-card"><div class="card-icon yellow" aria-hidden="true"><img src="/uploads/icons/icon-access.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F34E;';"></div><h3>Direct Tutor Access</h3><p>Message tutors directly. File complaints, ask questions, or just check in. Parents stay in the loop.</p></div>
                <div class="card service-card"><div class="card-icon blue" aria-hidden="true"><img src="/uploads/icons/icon-scheduling.png" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display='none';this.parentElement.textContent='&#x1F4C6;';"></div><h3>Easy Scheduling</h3><p>Our interactive calendar makes booking easy. See when tutors are available and manage everything in one place.</p></div>
            </div>
            <div style="text-align:center;margin-top:40px;">
                <a href="/services" class="btn btn-primary">Explore All Services</a>
            </div>
        </div>
    </section>

    <section class="carousel-section" aria-labelledby="carousel-heading">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">Our Amazing Team</span>
                <h2 id="carousel-heading">Meet Our Star Tutors</h2>
                <p>Handpicked educators passionate about making a difference.</p>
            </div>
        </div>
        <div class="carousel-track-wrapper">
            <div class="carousel-track">
                <% if (tutors && tutors.length > 0) { %>
                    <% tutors.forEach(function(tutor) { %>
                    <a href="/tutors" class="carousel-card" tabindex="0" style="text-decoration:none;color:inherit;">
                        <div class="carousel-card-header">
                            <div class="carousel-avatar"><% if (tutor.profile_picture) { %><img src="<%= tutor.profile_picture %>" alt="" loading="lazy" width="56" height="56"><% } else { %><%= tutor.first_name.charAt(0) %><%= tutor.last_name.charAt(0) %><% } %></div>
                            <div><h4><%= tutor.first_name %> <%= tutor.last_name %></h4><span class="subjects"><%= (tutor.subjects || []).join(', ') %></span></div>
                        </div>
                        <p><%= tutor.carousel_description || tutor.tagline || tutor.bio || 'Passionate about helping students succeed!' %></p>
                    </a>
                    <% }); %>
                <% } else { %>
                    <div class="carousel-card"><p style="color:var(--gray-400);text-align:center;">Our tutor profiles are being set up. Check back soon!</p></div>
                <% } %>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="why-heading">
        <div class="container">
            <div class="section-header">
                <span class="section-badge">Why <%= siteName %>?</span>
                <h2 id="why-heading">What Makes Us Different</h2>
            </div>
            <div class="services-grid">
                <div class="card"><div class="card-header"><div class="card-icon yellow" aria-hidden="true">&#x2B50;</div><h3 style="font-size:1.1rem;">Top Quality Tutors</h3></div><p style="color:var(--gray-500);">Every tutor goes through our rigorous vetting process. We only accept the best so your child gets the best.</p></div>
                <div class="card"><div class="card-header"><div class="card-icon orange" aria-hidden="true">&#x1F49A;</div><h3 style="font-size:1.1rem;">Giving Back</h3></div><p style="color:var(--gray-500);">A portion of our proceeds goes directly to <%= charityName %>. Invest in your child and help others too.</p></div>
                <div class="card"><div class="card-header"><div class="card-icon blue" aria-hidden="true">&#x1F91D;</div><h3 style="font-size:1.1rem;">Free First Session</h3></div><p style="color:var(--gray-500);">Our first session is a personal consultation with our founders -- no charge. We learn what your child needs, recommend a session plan, match them with the right tutor, and walk you through signing up, using the platform, and everything in between.</p></div>
            </div>
        </div>
    </section>

    <section class="section" style="background:linear-gradient(135deg,var(--blue-700),var(--blue-900));text-align:center;color:white;">
        <div class="container">
            <h2 style="color:white;font-size:2.5rem;margin-bottom:16px;">Ready to Help Your Child Shine?</h2>
            <p style="color:var(--blue-200);font-size:1.2rem;max-width:600px;margin:0 auto 32px;">Book a free consultation call and discover how we can transform your child's learning experience.</p>
            <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                <a href="/consultation" class="btn btn-secondary btn-lg">Book Free Consultation</a>
                <a href="/auth/register" class="btn btn-lg" style="background:rgba(255,255,255,0.15);color:white;border:2px solid rgba(255,255,255,0.3);">Sign Up Today</a>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
